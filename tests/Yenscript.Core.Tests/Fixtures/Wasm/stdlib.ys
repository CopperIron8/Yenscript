using package system;
from system import *;
fn main() {
    var value: int = math:pow(2, 5);
    if (value == 32 && math:abs(-3) == 3 && math:min(4, 8) == 4 && math:max(4, 8) == 8 && math:clamp(99, 0, 10) == 10) {
        console:print(strings:concat("value=", convert:intToString(value)));
    }
    console:warning(convert:intToString(-2147483648));
    console:error(convert:boolToString(false));
    console:print(convert:boolToString(true));
    if (strings:byteLength("世界") == 6) { console:print("utf8-ok"); }
}
